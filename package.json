{
  "private": true,
  "type": "module",
  "name": "empty-template-project",
  "version": "1.2.0",
  "description": "Repo Template: webpack, mocha-chai, babel, css, eslint",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "browserslist": [
    "baseline 2025"
  ],
  "prettier": "@epreston/prettier-config",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "rimraf -g -v dist/*",
    "dev": "npm run build-dev",
    "build": "npm run build-prod",
    "build-dev": "webpack --mode development",
    "build-prod": "webpack --mode production",
    "lint": "eslint .",
    "start": "webpack serve --open --mode development",
    "preview": "webpack serve --open --mode production",
    "test": "mocha",
    "watch": "webpack --watch --mode development"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@epreston/eslint-config": "^2.4.2",
    "@epreston/prettier-config": "^2.1.1",
    "@epreston/tsconfig": "^1.2.2",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "html-webpack-plugin": "^5.6.8",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "allowScripts": {
    "core-js": true
  }
}
